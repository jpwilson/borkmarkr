# bookmarker MCP Server Environment Variables

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# User Authentication
# This is the access token for the authenticated user whose bookmarks will be accessed
# Users should generate this from their bookmarker account settings
SUPABASE_USER_ACCESS_TOKEN=user-access-token-here
