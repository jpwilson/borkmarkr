{
 "_rules": {
  "subtopicChips(all, suggested, used)": "Only names found in `all`, matched case-insensitively and shown in `all`'s spelling. Order: suggested (as given), then used (as given), then the rest of `all` in the order given (callers pass it A-Z). A name appears once (first place wins, case-insensitive). Empty `all` gives [].",
  "tagChips(chosen, suggested, recent)": "Every tag is trimmed and lowercased; empty ones are skipped. Order: chosen tags that are in neither suggested nor recent (as given), then suggested, then recent. A tag appears once (first place wins). Site names (Platform.isSiteName / Filer.isSiteName) are dropped from suggested and recent, never from chosen. on = the tag is in chosen.",
  "cleanTag(raw)": "Remove every '#', trim, lowercase, collapse runs of whitespace to one space, keep the first 30 characters, trim again. Empty gives null."
 },
 "subtopics": [
  {
   "name": "suggested, then used, then the rest",
   "all": [
    "Cycling",
    "Running",
    "Swimming",
    "Yoga"
   ],
   "suggested": [
    "Running"
   ],
   "used": [
    "Yoga"
   ],
   "expect": [
    "Running",
    "Yoga",
    "Cycling",
    "Swimming"
   ]
  },
  {
   "name": "case-insensitive match keeps the canonical spelling",
